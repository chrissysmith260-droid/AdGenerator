{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "type": "chrome",
            "request": "launch",
            "name": "Book page: local preview",
            "url": "http://127.0.0.1:8080/",
            "webRoot": "${workspaceFolder}/docs",
            "preLaunchTask": "serve-book-page"
        },
        {
            "type": "chrome",
            "request": "launch",
            "name": "Book page: public HTTPS preview",
            "url": "${input:publicBookPageUrl}",
            "webRoot": "${workspaceFolder}/docs",
            "preLaunchTask": "serve-book-page"
        }
    ],
    "inputs": [
        {
            "id": "publicBookPageUrl",
            "type": "promptString",
            "description": "Paste the public HTTPS forwarded URL for port 8080",
            "default": "https://"
        }
    ]
}